[Unit]
Description=GallosOS Dynamic Configuration & State Daemon
After=network-online.target sysinit.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
# main.py's sibling modules use package-relative imports (`from .config
# import ...`), which only resolve when it runs as a package submodule —
# `python3 -m gallosd.main` from WorkingDirectory=/usr/libexec, not
# `python3 /usr/libexec/gallosd/main.py` (that raises ImportError:
# attempted relative import with no known parent package).
WorkingDirectory=/usr/libexec
ExecStart=/usr/bin/python3 -m gallosd.main
Restart=always
RestartSec=3s
OOMScoreAdjust=-900

# Security & Sandboxing (docs/ANTI_CHEAT_AND_SECURITY.md §9.3)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run /etc/nftables.conf /etc/polkit-1/rules.d /etc/udev/rules.d /etc/chromium/policies/managed /etc/firefox/policies /home/contestant /tmp
CapabilityBoundingSet=CAP_NET_ADMIN CAP_KILL CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
